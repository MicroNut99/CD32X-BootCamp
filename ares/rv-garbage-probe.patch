diff --git a/ares/md/m32x/bus-internal.cpp b/ares/md/m32x/bus-internal.cpp
index 008a9c7..f166c47 100644
--- a/ares/md/m32x/bus-internal.cpp
+++ b/ares/md/m32x/bus-internal.cpp
@@ -1,3 +1,10 @@
+static auto rvProbe() -> bool { static int on = -1; if(on < 0) on = getenv("ARES_RV_GARBAGE") ? 1 : 0; return on; }
+static auto rvLog(char who, u32 pc, u32 addr, u32 pr) -> void {
+  static std::set<u64> seen; static u32 count = 0;
+  count++;
+  u64 key = (u64)who << 40 | (u64)(pc & 0xfffffff) << 8;
+  if(seen.insert(key).second || (count & 127) == 0) fprintf(stderr, "RV-CART %c pc=%08x pr=%08x addr=%08x (n=%u)\n", who, pc, pr, addr, count);
+}
 auto M32X::readInternal(n1 upper, n1 lower, n32 address, n16 data) -> n16 {
   if(address >= 0x0000'0000 && address <= 0x0000'3fff) {
     if(shm.active()) shm.internalStep(1); if(shs.active()) shs.internalStep(1);
@@ -10,6 +17,13 @@ auto M32X::readInternal(n1 upper, n1 lower, n32 address, n16 data) -> n16 {
   }
 
   if(address >= 0x0200'0000 && address <= 0x03ff'ffff) {
+    if(dreq.vram && rvProbe()) {
+      //local test model (ARES_RV_GARBAGE=1): the console answers an SH2 cart access while the
+      //68000 holds RV = 1 with garbage instead of holding it (edsave3); log who did it
+      auto& cpu = shm.active() ? (SH7604&)shm : (SH7604&)shs;
+      rvLog(shm.active() ? 'M' : 'S', cpu.regs.PC, (u32)address, cpu.regs.PR);
+      return 0xdead;
+    }
     while(dreq.vram) {
       //SH2 ROM accesses stall while RV is set
       if(shm.active()) { shm.internalStep(1); shm.syncM68k(true); }
